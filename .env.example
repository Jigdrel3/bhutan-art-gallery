# Copy this file to .env.local (already gitignored) and fill in real values.

# Used by the app itself (safe to expose to the browser — these are public,
# read-only credentials once Row Level Security policies are applied via
# supabase/schema.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used ONLY by scripts/seed-supabase.mjs, run locally from your machine.
# The service role key bypasses RLS entirely — never commit it, never send
# it to the browser, never reuse it as VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
